# ===== 大模型（任配其一即切换真实模式，全部留空 = 内置演示引擎）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-max

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== 管理员后台（默认口令 admin123，登录 /admin 后请在面板内修改）=====
ADMIN_PASSWORD=

# ===== 存储与队列（可选，缺省时零依赖内存兜底）=====
QDRANT_URL=
POSTGRES_DSN=
REDIS_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ===== 运行环境标记（决定启动探针的严格程度）=====
# production：生产。多副本或生产模式下缺 REDIS_URL 会**拒绝启动**（避免配额被放大 N 倍）。
# 留空/development：本地开发，允许进程内降级，但 /api/v1/health 会如实回报 backend=process。
ENV=
# 极少数确为单副本、流量可控的内部部署，若坚持不装 Redis，可置 1 显式确认风险。
# 注意：该开关对多副本**无效**——多副本缺 Redis 一律拒绝启动。
ALLOW_PROCESS_LOCAL_STATE=

# ===== 容器启动行为 =====
# 启动时自动对齐数据库 schema（entrypoint 串行执行 alembic upgrade head）。
# 1（默认）：启用，失败则容器退出进入重启循环（问题明确暴露）。
# 0：关闭，交给手工控库的部署。
AUTO_MIGRATE=

# ===== 多租户体验额度 =====
# 新建机构租户时一次性发放的体验额度（额度单位，单次提问冻结 4000、实际约 800~1500）。
# 默认 50000（≈ 30~50 次提问）；0 表示关闭自动注资，改为纯后台充值模式。
# 说明：这是"一次性"而非"每天"，否则等于给每个租户无限免费额度。
TENANT_TRIAL_CREDITS=

# ===== 前端 =====
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# ===== 会员体系（可选）=====
# 留空：无注册用户时开放演示，首位用户注册后自动开启全站登录
# =1：部署即强制登录（正式运营推荐）
MEMBERSHIP_MODE=

# ===== 生产部署端口（docker-compose.prod.yml）=====
# 端口被其他项目占用时改这里即可，容器不用动
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ===== 小服务器内存调优（可选，留空用默认）=====
# 单容器：uvicorn 并发上限（超并发排队而非 OOM）
UVICORN_LIMIT_CONCURRENCY=24
# 单容器：Node 堆上限 MB（默认 192）
NODE_MAX_OLD_SPACE=192
