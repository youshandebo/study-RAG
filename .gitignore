# ---- frontend ----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local

# ---- backend ----
backend/__pycache__/
**/__pycache__/
*.pyc
backend/.venv/
backend/venv/

# 管理面板运行时配置（含打码前的模型 Key 与口令哈希）
backend/data/

# 运行时上传资产（录音/板书）——保留内置板书 SVG
backend/app/static/audio/*
backend/app/static/boards/*
!backend/app/static/boards/*.svg

# ---- 环境与密钥 ----
.env
.env.local
*.pem
*.key

# ---- 系统 ----
.DS_Store
*.log
nohup.out

# ---- 本地工作台数据（评审记录/会话记忆，非项目产物）----
.workbuddy/

# ---- 标定用的本地数据（查询池与抽取产物）----
# 查询池来自真实课堂日志、抽取产物是模型 logit dump，两者都与具体部署的
# 语料/模型绑定，不该进仓库。目录约定见 scripts/extract_rerank_dataset.py。
data/queries*.jsonl
data/eval_golden*.json

# ---- 标定用的本地模型权重与隔离环境 ----
# ONNX 权重 40~100MB 且随所选模型而异，不进仓库；
# .venv-rerank 是仅用于标定的隔离环境（onnxruntime + transformers）。
models/
.venv-rerank/